# Copy this file to .env and fill in the values you want to override.
# The project runs fully offline with the defaults below (TF-IDF retrieval +
# extractive fallback generation) -- no keys required to try it out.

# Enables real LLM generation via Gemini instead of the offline extractive fallback.
GOOGLE_API_KEY=

# auto | dense | tfidf   ("auto" tries dense embeddings, falls back to TF-IDF)
AGENTRAG_VECTOR_BACKEND=auto

# auto | gemini | extractive   ("auto" uses Gemini if GOOGLE_API_KEY is set)
AGENTRAG_LLM_BACKEND=auto

AGENTRAG_CHUNK_SIZE=800
AGENTRAG_CHUNK_OVERLAP=120
AGENTRAG_TOP_K=4
AGENTRAG_MAX_ATTEMPTS=2
AGENTRAG_GROUNDING_THRESHOLD=0.18
AGENTRAG_DOCS_DIR=data/sample_docs
