# Copy this file to .env and fill in the values you want to override.
# The project runs fully offline with the defaults below (TF-IDF retrieval +
# extractive fallback generation) -- no keys required to try it out.

# Enables real LLM generation via Gemini instead of the offline extractive fallback.
GOOGLE_API_KEY=

# auto | hybrid | bm25 | dense | tfidf
# "auto" = BM25 + bge-small dense fused with RRF when `pip install -e ".[dense]"` is
# present, otherwise plain BM25. CI sets this to tfidf for a fast, download-free run.
AGENTRAG_VECTOR_BACKEND=auto

# auto | gemini | extractive   ("auto" uses Gemini if GOOGLE_API_KEY is set)
AGENTRAG_LLM_BACKEND=auto

AGENTRAG_CHUNK_SIZE=800
AGENTRAG_CHUNK_OVERLAP=120
AGENTRAG_TOP_K=4
AGENTRAG_MAX_ATTEMPTS=2
AGENTRAG_GROUNDING_THRESHOLD=0.18
AGENTRAG_DOCS_DIR=data/sample_docs

# Relevance gate: minimum share of the question's topical terms that must
# appear in retrieved context before the system will answer at all.
# Below this it refuses instead of guessing.
AGENTRAG_MIN_QUERY_COVERAGE=0.40
AGENTRAG_MIN_RETRIEVAL_SCORE=0.02

# Gemini rate limits for the claim-verification experiments (scripts/run_verification.py).
# Limits are per project and per model; read yours in Google AI Studio. Blank / 0 = no client-side limit of
# that kind (RPM and TPM default to 10 and 200000). Whatever you set, a server 429 is still honoured.
# Observed on a free-tier project: gemini-3.8-flash allowed only 20 requests PER DAY.
AGENTRAG_GEMINI_RPM=10
AGENTRAG_GEMINI_TPM=200000
AGENTRAG_GEMINI_RPD=
AGENTRAG_GEMINI_MAX_CALLS=

# Hard spending limits for API experiments, enforced in code (agentrag/verify/budget.py): every call stops at
# whichever comes first. Spend is computed from token counts at list price and kept in a per-key ledger.
AGENTRAG_BUDGET_MAX_INR=600
AGENTRAG_BUDGET_MAX_CALLS=2000

# Observability
# Print raw OpenTelemetry spans to stdout
AGENTRAG_OTEL_CONSOLE=0
# Export spans to an OTLP collector (Jaeger, Tempo, Azure Monitor, ...)
AGENTRAG_OTEL_OTLP=0
OTEL_EXPORTER_OTLP_ENDPOINT=
